# VITE_GAS_URL: 예약 · 문의 접수를 받을 구글 Apps Script 웹앱 주소.
#
# 이 값이 없으면 폼은 "접수되었습니다"를 띄우지 않고 전화번호를 안내합니다.
# 받지도 못한 신청을 접수됐다고 알리지 않기 위한 동작입니다.
#
# Vercel에서는 Settings > Environment Variables 에 같은 이름으로 넣으면 됩니다.
# 넣은 뒤 반드시 재배포해야 적용됩니다 (빌드 시점에 값이 들어가므로).
VITE_GAS_URL="https://script.google.com/macros/s/.../exec"

# GEMINI_API_KEY: 현재 코드에서 호출하는 곳이 없습니다.
# AI Studio에서 자동 주입하던 값이라 참고용으로만 남겨둡니다.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: AI Studio가 호스팅 주소를 주입하던 값. Vercel 배포에는 쓰이지 않습니다.
APP_URL="MY_APP_URL"
